# Variables de entorno del módulo de interfaz (frontend) de CONGENIA.
# Copiar a .env y completar con los valores reales. NO incluir credenciales reales en este archivo.

# URL base de la API del backend de CONGENIA (p. ej. http://localhost:3000 en desarrollo).
VITE_API_BASE_URL=url_api_backend

# Servidor de identidad OIDC (Keycloak): URL del realm y client ID de la aplicación web.
VITE_OIDC_AUTHORITY=url_realm_oidc
VITE_OIDC_CLIENT_ID=client_id_oidc

# Etiqueta del entorno (p. ej. development, test o production).
# Si los mocks de abajo se dejan vacíos, adendas y CIE-10 usan datos simulados con
# development/dev/test, y la búsqueda de fichas solo con test.
VITE_APP_ENV=development

# Permite iniciar una sesión de desarrollo sin el servidor OIDC (solo para desarrollo local).
VITE_ALLOW_DEV_SESSION=false

# Datos simulados en lugar de la API: true para forzarlos, false para usar siempre la API real,
# vacío para decidir según VITE_APP_ENV.
VITE_USE_FICHA_SEARCH_MOCK=
VITE_USE_ADENDAS_MOCK=
VITE_USE_CIE10_MOCK=
